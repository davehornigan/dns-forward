{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "domains-resolver config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "include": {
      "type": ["array", "null"],
      "items": { "type": "string" },
      "description": "Paths or globs of .yaml files, each named after the section it holds. Relative to the main config's directory."
    },
    "upstreams": {
      "type": "array",
      "items": { "type": "string" }
    },
    "fallbackUpstreams": {
      "type": ["array", "null"],
      "items": { "type": "string" }
    },
    "domains": {
      "type": ["array", "null"],
      "items": { "$ref": "#/$defs/domainRule" }
    },
    "outputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/output" }
    },
    "server": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "debug": { "type": ["boolean", "null"] },
        "listenAddr": { "type": ["string", "null"] },
        "timeout": { "type": ["string", "null"] },
        "dnsTimeout": { "type": ["string", "null"] },
        "httpTimeout": { "type": ["string", "null"] },
        "excludeSubnets": { "type": ["array", "null"], "items": { "type": "string" } },
        "writeIPWithPrefix": { "type": ["boolean", "null"] },
        "resolveAllDomainsOnStart": { "type": ["boolean", "null"] },
        "cacheSize": { "type": ["integer", "null"], "minimum": 0, "$comment": "0 disables the cache; omit for the default" },
        "negativeTTL": { "type": ["string", "null"] }
      }
    }
  },
  "$comment": "upstreams and outputs are required at runtime, but either may come from an included file, so neither is required here.",
  "$defs": {
    "domainRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "domain": { "type": "string" },
        "matchingType": { "type": ["string", "null"], "enum": ["exact", "withSubdomains", "subdomainsOnly", "subdomainRegex", null] },
        "regex": { "type": ["string", "null"], "format": "regex", "$comment": "subdomainRegex only: matched against the part of the name before the domain" },
        "maxDepth": { "type": ["integer", "null"], "minimum": 0 },
        "listName": { "type": ["string", "null"] },
        "outputs": { "type": ["array", "null"], "items": { "type": "string" } },
        "disableFallback": { "type": ["boolean", "null"] },
        "upstreamsOverride": { "type": ["array", "null"], "items": { "type": "string" } },
        "upstreamsBlacklist": { "type": ["array", "null"], "items": { "type": "string" } },
        "records": {
          "type": ["object", "null"],
          "propertyNames": { "pattern": "^[A-Za-z0-9]+$" },
          "additionalProperties": {
            "oneOf": [
              { "type": "string" },
              { "type": "array", "items": { "type": "string" } }
            ]
          },
          "properties": {
            "CNAME": { "type": "string", "$comment": "a name has exactly one canonical name, so a list is not allowed" },
            "cname": { "type": "string" }
          }
        },
        "recordsTTL": { "type": ["string", "null"] },
        "recordsOnly": { "type": ["boolean", "null"] }
      },
      "required": ["domain"],
      "allOf": [
        { "not": { "required": ["upstreamsOverride", "upstreamsBlacklist"] } },
        {
          "$comment": "regex and matchingType: subdomainRegex require each other",
          "if": { "properties": { "matchingType": { "const": "subdomainRegex" } }, "required": ["matchingType"] },
          "then": { "required": ["regex"] },
          "else": {
            "if": { "required": ["regex"], "properties": { "regex": { "type": "string" } } },
            "then": { "properties": { "matchingType": { "type": "null" } } }
          }
        }
      ]
    },
    "output": {
      "oneOf": [
        { "$ref": "#/$defs/outputRosApiAddressList" },
        { "$ref": "#/$defs/outputRosRestApiAddressList" },
        { "$ref": "#/$defs/outputFile" },
        { "$ref": "#/$defs/outputWebhook" }
      ]
    },
    "outputRosApiAddressList": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "const": "rosApiAddressList" },
        "mode": { "type": ["string", "null"], "enum": ["active", "passive", null] },
        "id": { "type": "string" },
        "host": { "type": "string" },
        "port": { "type": ["integer", "null"], "minimum": 1, "maximum": 65535 },
        "useTLS": { "type": ["boolean", "null"] },
        "username": { "type": "string" },
        "password": { "type": "string" },
        "listName": { "type": "string" },
        "ttl": { "type": ["string", "null"] },
        "updateTTL": { "type": ["boolean", "null"] },
        "recordType": { "type": "string", "enum": ["ip", "host"] },
        "connectionAttempts": { "type": ["integer", "null"], "minimum": 1 },
        "reconnectionAttempts": { "type": ["integer", "null"], "minimum": 1 },
        "maxConcurrentRequests": { "type": ["integer", "null"], "minimum": 1 },
        "minRequestInterval": { "type": ["string", "null"] },
        "refreshInterval": { "type": ["string", "null"] },
        "restoreClearedList": { "type": ["boolean", "null"] }
      },
      "required": ["type", "id", "host", "username", "password", "listName", "recordType"]
    },
    "outputRosRestApiAddressList": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "const": "rosRestApiAddressList" },
        "mode": { "type": ["string", "null"], "enum": ["active", "passive", null] },
        "id": { "type": "string" },
        "host": { "type": "string" },
        "port": { "type": ["integer", "null"], "minimum": 1, "maximum": 65535 },
        "useTLS": { "type": ["boolean", "null"] },
        "username": { "type": "string" },
        "password": { "type": "string" },
        "listName": { "type": "string" },
        "ttl": { "type": ["string", "null"] },
        "updateTTL": { "type": ["boolean", "null"] },
        "recordType": { "type": "string", "enum": ["ip", "host"] },
        "connectionAttempts": { "type": ["integer", "null"], "minimum": 1 },
        "reconnectionAttempts": { "type": ["integer", "null"], "minimum": 1 },
        "maxConcurrentRequests": { "type": ["integer", "null"], "minimum": 1 },
        "minRequestInterval": { "type": ["string", "null"] },
        "refreshInterval": { "type": ["string", "null"] },
        "restoreClearedList": { "type": ["boolean", "null"] }
      },
      "required": ["type", "id", "host", "username", "password", "listName", "recordType"]
    },
    "outputFile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "const": "file" },
        "mode": { "type": ["string", "null"], "enum": ["active", "passive", null] },
        "id": { "type": "string" },
        "path": { "type": "string" },
        "listName": { "type": "string" },
        "format": { "type": "string", "enum": ["csv", "ipset", "nftset"] }
      },
      "required": ["type", "id", "path", "listName"]
    },
    "outputWebhook": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "const": "webhook" },
        "mode": { "type": ["string", "null"], "enum": ["active", "passive", null] },
        "id": { "type": "string" },
        "method": { "type": ["string", "null"] },
        "url": { "type": "string" },
        "listName": { "type": "string" }
      },
      "required": ["type", "id", "url", "listName"]
    }
  }
}
